# ==============================================================================
# Google Cloud Application Integration - Configurações de Ambiente
# ==============================================================================

# Identificação do Projeto Google Cloud e Região
GCP_PROJECT_ID=seu-projeto-gcp-id
GCP_LOCATION=us-central1

# Service Account que executará os fluxos (runAsServiceAccount)
# Requer permissões de: Integrations Editor/Invoker, Drive, Sheets, Vertex AI, BigQuery
APPINT_SERVICE_ACCOUNT=appint-drive-sheets@seu-projeto-gcp-id.iam.gserviceaccount.com

# Auth Profile (AuthConfig) do Application Integration (usado para Google APIs REST)
AUTH_CONFIG_ID=e2bbf6a3-8d6b-43a4-a491-5011bc9bee1e

# Google Drive e Google Sheets
DRIVE_FOLDER_ID=14dZ6mA6hNNOqxixI679NG2mSCG6g_dMO
DRIVE_PROCESSED_FOLDER_ID=1e0hYk3b7g8jK9Lm...
SHEETS_SPREADSHEET_ID=1mjqIz1LvNwyZSj1_LTfKcMVbb4jDIULjNb-YQmkrKr8
SHEETS_SHEET_NAME=Sheet1

# BigQuery (Para o fluxo de CDC Salesforce)
BQ_DATASET_ID=salesforce_staging
BQ_TABLE_ID=opportunities

# Vertex AI Agent / Reasoning Engine (Região de IA, ex: us-west1 ou us-central1)
VERTEX_AI_LOCATION=us-west1
