        "script": {
          "key": "script",
          "value": {
            "stringValue": "function executesScript(event) {\n  var downloadedBody = event.getParameter('`Task_3_responseBody`') || event.getParameter('Task_3_responseBody') || '';\n  var inputDocContent = event.getParameter('document_content') || '';\n  var docName = event.getParameter('document_name') || 'Documento';\n\n  var fullContent = downloadedBody || inputDocContent || '';\n\n  var userPromptText = 'Analise o seguinte documento na íntegra para identificação jurídica e verificação de pedidos:\\n' +\n    'Nome do Arquivo: ' + docName + '\\n\\n' +\n    '===== INÍCIO DO DOCUMENTO COMPLETO =====\\n' +\n    fullContent + '\\n' +\n    '===== FIM DO DOCUMENTO COMPLETO =====';\n\n  var a2aPayload = {\n    message: {\n      role: 'ROLE_USER',\n      content: [\n        {\n          text: userPromptText\n        }\n      ]\n    }\n  };\n\n  event.setParameter('agent_request_body', JSON.stringify(a2aPayload));\n  event.setParameter('status', 'FULL_DOCUMENT_PAYLOAD_PREPARED');\n}\n\nfunction executeScript(event) {\n  executesScript(event);\n}"
